{
 "schemaVersion": 1,
 "note": "基础组件库 ui-primitives 的精选条目。css 字段指向真实 CSS Module 源码，构建时原文内联进 shadow root。",
 "entries": [
  {
   "id": "button",
   "name": "Button",
   "exportName": "Button",
   "zh": "按钮",
   "group": "controls",
   "summary": "点击动作控件。<code>variant</code> 选择 <code>primary</code> / <code>ghost</code> / <code>outline</code> / <code>toolbar</code> 四族填充，<code>size</code> 选择 36px 高的 <code>md</code>（12px 圆角）或 28px 高的 <code>sm</code>（8px 圆角）。<code>ref</code> 指向原生 button，供焦点管理与浮层锚点使用。",
   "source": "packages/client/ui-primitives/src/Button.tsx#L27",
   "css": ["packages/client/ui-primitives/src/Button.module.css"],
   "tokens": ["--dsw-alias-button-primary-fill", "--dsw-alias-button-primary-hover", "--dsw-alias-button-tool-bar-fill", "--dsw-alias-interactive-bg-hover", "--dsw-alias-border-l3", "--dsw-radius-md", "--dsw-radius-sm"],
   "specimens": [
    {
     "label": "variant × md（36px 高）",
     "html": "<button class=\"button primary md\">主操作</button><button class=\"button ghost md\">次要</button><button class=\"button outline md\">描边</button><button class=\"button toolbar md\">工具条</button>"
    },
    {
     "label": "size=sm（28px 高，8px 圆角）",
     "html": "<button class=\"button primary sm\">保存</button><button class=\"button ghost sm\">取消</button><button class=\"button outline sm\">重置</button>"
    },
    {
     "label": "带前置图标 / 禁用",
     "note": "图标槽固定 16px",
     "html": "<button class=\"button ghost md\"><span class=\"icon\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>继续</button><button class=\"button primary md\" disabled>不可用</button>"
    }
   ],
   "props": [
    { "name": "variant", "type": "'primary' | 'ghost' | 'outline' | 'toolbar'", "default": "'ghost'", "desc": "视觉族，各自对应一组 --dsw-alias-button-* 填充变量。" },
    { "name": "size", "type": "'md' | 'sm'", "default": "'md'", "desc": "md = 36px 高 / 12px 圆角；sm = 28px 高 / 8px 圆角。" },
    { "name": "icon", "type": "ReactNode", "default": "—", "desc": "可选前置 16px 图标节点。" },
    { "name": "className", "type": "string | undefined", "default": "—", "desc": "调用方的布局类，叠加在原子类之后。" }
   ],
   "notes": "禁用态统一为 <code>opacity: 0.4</code> 且 <code>cursor: not-allowed</code>。悬停与按下分别走 <code>--dsw-alias-interactive-bg-hover</code> 与 <code>-active</code>。"
  },
  {
   "id": "switch",
   "name": "Switch",
   "exportName": "Switch",
   "zh": "开关",
   "group": "controls",
   "summary": "两态开关，固定 36×20。开合外观绑定在 <code>aria-checked</code> 上而不是另加一个类，因此视觉状态不可能与辅助技术读到的状态不一致。<code>label</code> 为必填，控件无法在不具名的情况下出厂。",
   "source": "packages/client/ui-primitives/src/Switch.tsx#L18",
   "css": ["packages/client/ui-primitives/src/Switch.module.css"],
   "tokens": ["--dsw-alias-border-l3", "--dsw-alias-brand-primary", "--dsw-alias-switch-thumb", "--dsw-alias-label-primary-foreground"],
   "specimens": [
    {
     "label": "关 / 开 / 禁用",
     "html": "<button type=\"button\" role=\"switch\" aria-checked=\"false\" aria-label=\"关闭\" class=\"switch\"><span class=\"thumb\"></span></button><button type=\"button\" role=\"switch\" aria-checked=\"true\" aria-label=\"开启\" class=\"switch\"><span class=\"thumb\"></span></button><button type=\"button\" role=\"switch\" aria-checked=\"true\" aria-label=\"已锁定\" class=\"switch\" disabled><span class=\"thumb\"></span></button>"
    }
   ],
   "props": [
    { "name": "checked", "type": "boolean", "default": "—", "desc": "当前状态；控件完全受控。" },
    { "name": "onChange", "type": "(next: boolean) => void", "default": "—", "desc": "点击请求的目标状态。" },
    { "name": "label", "type": "string", "default": "—", "desc": "本地化的无障碍名称，必填。" },
    { "name": "disabled", "type": "boolean", "default": "false", "desc": "拒绝输入；写入进行中时调用方也应置位。" },
    { "name": "title", "type": "string | undefined", "default": "—", "desc": "本地化悬停文本，通常说明为何被锁定。" }
   ],
   "notes": "关闭态的滑块读取 <code>--dsw-alias-switch-thumb</code>，两种主题下都保持浅色；开启态滑块改用 <code>--dsw-alias-label-primary-foreground</code> 与品牌色轨道形成对比。"
  },
  {
   "id": "pill",
   "name": "Pill",
   "exportName": "Pill",
   "zh": "胶囊",
   "group": "display",
   "summary": "24px 文字行高度的胶囊控件。传入 <code>onClick</code> 时渲染为可选择的 button（视图切换、过滤器），否则渲染为静态 span（例如 <code>TerminalBlock</code> 的退出状态）。11px 的只读徽标是 <code>Tag</code>——尺寸与可交互性共同区分两者。",
   "source": "packages/client/ui-primitives/src/Pill.tsx#L17",
   "css": ["packages/client/ui-primitives/src/Pill.module.css"],
   "tokens": ["--dsw-alias-bg-layer-2", "--dsw-alias-interactive-bg-hover", "--dsw-alias-button-ghost-active-fill", "--dsw-alias-button-ghost-active-border"],
   "specimens": [
    {
     "label": "默认 / 选中 / 静态",
     "html": "<button class=\"pill interactive\">全部</button><button class=\"pill interactive active\">进行中</button><span class=\"pill\">exit 0</span>"
    }
   ],
   "props": [
    { "name": "active", "type": "boolean", "default": "false", "desc": "选中态：主文字色 + 幽灵按钮激活填充 + 内描边。" },
    { "name": "onClick", "type": "MouseEventHandler", "default": "—", "desc": "提供时渲染为 button 并启用指针样式与悬停底色。" },
    { "name": "children", "type": "ReactNode", "default": "—", "desc": "胶囊内容。" }
   ]
  },
  {
   "id": "tag",
   "name": "Tag",
   "exportName": "Tag",
   "zh": "徽标",
   "group": "display",
   "summary": "只读胶囊徽标，几何固定为 11px / 17px 行高，只有配色随 <code>tone</code> 变化。<code>tone</code> 提供八种调色：<code>outline</code>、<code>solid</code>、<code>neutral</code>、<code>quiet</code>，以及 success / info / warning / danger 四种状态色。",
   "source": "packages/client/ui-primitives/src/Tag.tsx#L22",
   "css": ["packages/client/ui-primitives/src/Tag.module.css"],
   "tokens": ["--dsw-alias-border-l4", "--dsw-alias-label-tertiary", "--dsw-alias-label-primary", "--dsw-alias-bg-module-platform", "--dsw-alias-state-success-primary", "--dsw-alias-state-warn-primary", "--dsw-alias-state-error-primary", "--dsw-alias-state-business-primary"],
   "specimens": [
    {
     "label": "八种 tone",
     "html": "<span class=\"tag\" data-tone=\"outline\">outline</span><span class=\"tag\" data-tone=\"solid\">solid</span><span class=\"tag\" data-tone=\"neutral\">neutral</span><span class=\"tag\" data-tone=\"quiet\">quiet</span><span class=\"tag\" data-tone=\"success\">已启用</span><span class=\"tag\" data-tone=\"info\">信息</span><span class=\"tag\" data-tone=\"warning\">需授权</span><span class=\"tag\" data-tone=\"danger\">失败</span>"
    }
   ],
   "props": [
    { "name": "tone", "type": "TagTone", "default": "'neutral'", "desc": "八种调色之一。" },
    { "name": "children", "type": "ReactNode", "default": "—", "desc": "徽标文本。" }
   ],
   "notes": "状态色调的背景由自身颜色 <code>color-mix(in srgb, … 10%, transparent)</code> 生成（warning 为 12%），因此换调色板时填充与文字一起移动。"
  },
  {
   "id": "state-dot",
   "name": "StateDot",
   "exportName": "StateDot",
   "zh": "状态点",
   "group": "display",
   "summary": "工具调用与任务行的状态标记。<code>done</code> 绿、<code>warning</code> 琥珀、<code>error</code> 红、<code>idle</code> 中性灰都占 10px 布局槽但只画 6px 实心圆；<code>ongoing</code> 是唯一的非圆点状态——14px 旋转加载环，其动画起点固定在文档时间零点，因此列表重排后所有可见加载环仍然同步。<code>appearance=\"step\"</code> 改为步骤样式：完成为实心勾，待办为空心圆。",
   "source": "packages/client/ui-primitives/src/StateDot.tsx#L60",
   "css": ["packages/client/ui-primitives/src/StateDot.module.css"],
   "tokens": ["--dsw-alias-state-success-primary", "--dsw-alias-state-warn-primary", "--dsw-alias-state-error-primary", "--dsw-alias-state-idle-primary", "--dsw-alias-label-tertiary"],
   "specimens": [
    {
     "label": "四种实心状态（10px 槽）",
     "html": "<span class=\"dot\" data-state=\"done\" style=\"width:10px;height:10px\"></span><span class=\"dot\" data-state=\"warning\" style=\"width:10px;height:10px\"></span><span class=\"dot\" data-state=\"error\" style=\"width:10px;height:10px\"></span><span class=\"dot\" data-state=\"idle\" style=\"width:10px;height:10px\"></span>"
    },
    {
     "label": "appearance=\"step\"",
     "html": "<span class=\"step\" data-state=\"done\" style=\"width:14px;height:14px\"><svg width=\"9\" height=\"9\" viewBox=\"0 0 9 9\" fill=\"none\"><path d=\"M1.5 4.6 3.4 6.5 7.6 2.4\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"step\" data-state=\"pending\" style=\"width:14px;height:14px\"></span><span class=\"step\" data-state=\"warning\" style=\"width:14px;height:14px\"></span><span class=\"step\" data-state=\"error\" style=\"width:14px;height:14px\"></span>"
    },
    {
     "label": "ongoing 加载环（1.5s 旋转 + 呼吸弧）",
     "html": "<span class=\"spinner\" style=\"width:14px;height:14px\"><svg class=\"spinnerMotion\" width=\"14\" height=\"14\" viewBox=\"0 0 14 14\"><circle class=\"spinnerTrack\" cx=\"7\" cy=\"7\" r=\"6\"></circle><circle class=\"spinnerArc\" cx=\"7\" cy=\"7\" r=\"6\"></circle></svg></span>"
    }
   ],
   "props": [
    { "name": "state", "type": "StateDotState", "default": "—", "desc": "'done' | 'warning' | 'error' | 'idle' | 'ongoing'。" },
    { "name": "appearance", "type": "'dot' | 'step'", "default": "'dot'", "desc": "dot 为实心点，step 为步骤实心 / 空心圆。" }
   ],
   "notes": "<code>aria-hidden</code>，无障碍名称由渲染处负责。"
  }
 ]
}
